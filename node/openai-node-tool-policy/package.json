{
  "name": "@examples/openai-node-tool-policy",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAI Node SDK-style agent example with Agent Assembly tool policy enforcement",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
